# ---------------------------------------------------------------------------
# كل المتغيرات اختيارية. بدونها يعمل التطبيق ببيانات تجريبية موسومة بوضوح.
# انسخ هذا الملف إلى .env.local للتطوير المحلي،
# أو اضبط القيم في Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# مصدر بيانات الحرائق (JSON). يقبل: مصفوفة، أو { "fires": [...] }، أو GeoJSON.
# مثال: دالة Vercel تُمرّر بيانات NASA FIRMS بعد تحويلها إلى JSON.
VITE_FIRES_API_URL=

# ترويسة اعتماد اختيارية للمصدر أعلاه، مثل: Bearer xxxxx
VITE_FIRES_API_AUTH=

# وجهة استقبال بلاغات المستخدمين (POST application/json).
# أي خدمة تصلح: Vercel Function، Cloudflare Worker، Formspree، Google Apps Script، n8n…
VITE_REPORT_ENDPOINT=

# ترويسة اعتماد اختيارية لوجهة البلاغات
VITE_REPORT_ENDPOINT_AUTH=

# مزوّد بلاط الخريطة (الافتراضي: OpenStreetMap)
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# إعادة الجلب التلقائي بالدقائق (0 = تعطيل). الافتراضي 10
VITE_REFRESH_MINUTES=10

# نافذة مرشّح "حديث" بالساعات. الافتراضي 24
VITE_RECENT_HOURS=24
