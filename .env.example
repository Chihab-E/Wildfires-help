# ---------------------------------------------------------------------------
# التطبيق يعمل بدون أي متغير — عندها يعرض بيانات تجريبية موسومة بوضوح.
#
# للحصول على حرائق حقيقية تُحدَّث تلقائياً، يكفي متغيّر واحد على الخادم:
#   FIRMS_MAP_KEY
# ---------------------------------------------------------------------------


# ======= متغيرات الخادم (سرّية — لا تصل إلى المتصفح) =======
# تُضبط في Vercel → Settings → Environment Variables

# مفتاح NASA FIRMS المجاني. اطلبه من:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# بدونه تُرجع /api/fires رمز 503 ويعود التطبيق للبيانات التجريبية.
FIRMS_MAP_KEY=

# مصادر الأقمار الصناعية مفصولة بفواصل.
# الافتراضي: VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT
# خيارات أخرى: VIIRS_NOAA21_NRT، MODIS_NRT
FIRMS_SOURCES=

# عدد الأيام السابقة المطلوبة (1..10). الافتراضي 1
FIRMS_DAYS=1


# ======= متغيرات الواجهة (VITE_*) =======
# ⚠️ تُحزَم داخل ملفات JavaScript العلنية — لا تضع فيها أي سرّ.

# مصدر بيانات الحرائق. الافتراضي /api/fires (الدالة المرفقة).
# ضع `off` لإجبار البيانات التجريبية، أو عنواناً آخر لمصدر بديل.
VITE_FIRES_API_URL=

# ترويسة اعتماد اختيارية للمصدر أعلاه، مثل: Bearer xxxxx
VITE_FIRES_API_AUTH=

# مزوّد بلاط الخريطة (الافتراضي: OpenStreetMap)
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# إعادة الجلب التلقائي بالدقائق (0 = تعطيل). الافتراضي 10
VITE_REFRESH_MINUTES=10

# نافذة مرشّح "حديث" بالساعات. الافتراضي 24
VITE_RECENT_HOURS=24
